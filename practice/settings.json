{
  "permissions": {
    "allow": [
      "Bash",            // 쉘 명령 실행 허용
      "WebSearch",       // 웹 검색 허용
      "Edit(./**)",      // 모든 파일 편집 허용
      "Read(./**)"       // 모든 파일 읽기 허용
    ],
    "deny": [
      "Read(./.env)",        // .env 읽기 금지 (API 키 보호)      
      "Read(./secrets/**)",  // secrets 폴더 읽기 금지
    ],
    "ask": [
      "Bash(git push:*)"     // git push는 확인 후 실행
    ],
    "defaultMode": "acceptEdits"  // 편집 자동 수락
  }
}
